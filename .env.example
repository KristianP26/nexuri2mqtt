# Nexuri portal credentials (the same ones you use at app.nexuri.cz)
NEXURI_EMAIL=you@example.com
NEXURI_PASSWORD=changeme
NEXURI_BASE_URL=https://backend.nexuri.cz

# MQTT broker
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PREFIX=nexuri
MQTT_DISCOVERY_PREFIX=homeassistant

# Seconds between sensor polls. Each poll reaches the hardware in your flat.
POLL_INTERVAL=60
# Seconds between device-list refreshes (picks up newly installed hardware).
DISCOVERY_INTERVAL=3600

# Publish communal building hardware (main entrance, garage, lifts, bike racks)
INCLUDE_SHARED=false

LOG_LEVEL=INFO
